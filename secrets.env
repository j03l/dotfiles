# Bitwarden Secrets Manager mapping
# FORMAT: UUID  TARGET_PATH  PERMISSIONS  [ENV]
# ENV is optional. Leave blank to always deploy. Set to home/work to filter.
3b914380-8b31-42f3-8b31-b3f90052d698  ~/.gitconfig.local                    600
416dca49-825c-4fab-ab28-b3f900530d6b  ~/.git-credentials                    600
c3cb4dc8-4160-4061-9a03-b3f90053537a  ~/.config/gh/hosts.yml                600
768ae659-834b-467c-9087-b3f900539715  ~/.config/github-copilot/apps.json    600
fc60d531-9660-4460-91f9-b3f90053dedd  ~/.config/rclone/rclone.conf          600  home
9dec4ac9-b509-4a02-a76d-b3f9005400db  ~/.bootdev.yaml                       600  home
6021296b-48d6-4183-a85d-b3fe0044a0b5  ~/.config/gitlab/token                600  home
01660c32-a7b2-49ed-b7e1-b3ff0055b54f  ~/.config/ynab/token                  600  home
019adaf6-f2d5-4557-a521-b403008cfb10  ~/.config/claude/oauth_token          600  home
# <work-uuid>                          ~/.config/claude/oauth_token          600  work
a286cf2c-7744-43f1-a8e7-b3ff006350ea  ~/.config/claude/context7_api_key     600

# SSH keys. To add another, note that bws reads the key's leading "-----BEGIN" as
# a flag, so a `--` separator is required:
#   bws secret create -o json -- ssh-<name> "$(cat ~/.ssh/<name>)" \
#       2a718943-39bd-4ff7-af29-b3f9004a9a97 | jq -r .id
# Identity keys are deliberately per-machine, not one key synced everywhere: each
# machine's public key is registered separately on GitHub ("Work PC", "hunter", …),
# so one can be revoked without touching the others and a compromise stays local.
# Hence the home/work scoping below rather than a blank ENV column.
#
# Consequence: add the work pair BEFORE running ./secrets on the work PC. An entry
# scoped to another environment is removed by the clean pass, so leaving the work
# lines commented out would delete that machine's own key at the same path.
#
# When adding a machine, also append its *public* key to env/.ssh/allowed_signers,
# or commits it signs will not verify locally on the others.
5e1ad392-00f8-444e-a3ce-b49200e2979f  ~/.ssh/id_ed25519                     600  home
17431113-1209-4bc6-948f-b49200e29877  ~/.ssh/id_ed25519.pub                 644  home
# <work-uuid>                          ~/.ssh/id_ed25519                     600  work
# <work-uuid>                          ~/.ssh/id_ed25519.pub                 644  work
8c1abde5-3373-4c1c-9f2d-b49200e29941  ~/.ssh/unraid                         600  home
ad6e8e52-94ca-4380-9826-b49200e29a18  ~/.ssh/unraid.pub                     644  home
# Not mapped on purpose: ssh-github_signing-retired (c14e10ff-…) is an archive of
# the key retired in 7a60740. Its public half stays in env/.ssh/allowed_signers so
# commits signed before the switch still verify.
