[Unit]
Description=OneDrive rclone mount
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/OneDrive
# dir-cache-time was unset, so listings fell back to rclone's 5m default and a
# cold `ls ~/OneDrive` cost 1.4s against 0.005s warm. attr-timeout was likewise
# unset (default 1s), sending every stat older than a second back through FUSE.
# 10m matches the icloud mount. OneDrive edits made elsewhere take up to that
# long to appear; --onedrive-delta below still picks up changes on poll.
ExecStart=/usr/bin/rclone mount onedrive: %h/OneDrive \
  --vfs-cache-mode full \
  --dir-cache-time 10m \
  --attr-timeout 5s \
  --vfs-cache-max-age 720h \
  --vfs-cache-max-size 50G \
  --onedrive-delta \
  --buffer-size 128M \
  --vfs-read-ahead 256M \
  --vfs-read-chunk-size 32M \
  --vfs-read-chunk-size-limit 256M \
  --log-level NOTICE \
  --log-file %h/.cache/rclone/onedrive-mount.log
ExecStop=/usr/bin/fusermount -u %h/OneDrive
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
