[Unit]
Description=rclone mount: obsidian WebDAV vault
Documentation=man:rclone(1)
# Tailscale must be up before the mount can reach the server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Recreate the mountpoint dir in case /mnt is empty at login
ExecStartPre=-/usr/bin/mkdir -p /mnt/obsidian
# cache-mode full, not writes: PDFs are read by seeking (trailer -> xref ->
# objects), and under `writes` every backward seek became a fresh WebDAV range
# request, so embedded PDFs rendered blank or partial. Matches the icloud and
# onedrive mounts. dir-cache-time/poll-interval stay short so edits made on
# other devices still show up quickly.
# size-only: this WebDAV backend reports no hashes and no usable modtime
# precision, so rclone couldn't confirm files were already synced and kept
# re-uploading everything in a loop every poll cycle.
ExecStart=/usr/bin/rclone mount obsidian: /mnt/obsidian \
    --config=%h/.config/rclone/rclone.conf \
    --vfs-cache-mode full \
    --size-only \
    --vfs-cache-max-age 168h \
    --vfs-cache-max-size 5G \
    --buffer-size 32M \
    --vfs-read-ahead 64M \
    --dir-cache-time 30s \
    --poll-interval 15s \
    --umask 022 \
    --log-level INFO
ExecStop=/usr/bin/fusermount3 -u /mnt/obsidian
# Auto-remount if the server/network drops
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
