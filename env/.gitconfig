[include]
	path = ~/.gitconfig.local

[user]
	email = hunter@tmbr.dog
	name = Hunter Hardy
	signingkey = ~/.ssh/id_ed25519.pub
[credential]
	helper = store
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://git.tmbr.dog"]
	provider = generic
[core]
	editor = nvim
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[init]
	defaultBranch = main
