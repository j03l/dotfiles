export XDG_CONFIG_HOME=$HOME/.config
export GIT_EDITOR=nvim
export DOTFILES="$HOME/dotfiles"
# BWS access token from the OS secret store (macOS Keychain / KDE Wallet).
# kwalletd6 was retired in kwallet 6.28 — ksecretd owns org.freedesktop.secrets now, and
# kwallet-query blocks ~50s on D-Bus activation before failing. timeout guards headless logins.
if [[ "$OSTYPE" == darwin* ]]; then
  export BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-access-token -w 2>/dev/null)
else
  export BWS_ACCESS_TOKEN=$(timeout 5 secret-tool lookup server Passwords user bws-access-token 2>/dev/null)
fi
export GITLAB_TOKEN=$(cat ~/.config/gitlab/token 2>/dev/null)
export CLAUDE_CODE_OAUTH_TOKEN=$(cat ~/.config/claude/oauth_token 2>/dev/null)

# tmux-sessionizer keybinds
bindkey -s ^f "tmux-sessionizer\n"

# Session bookmark goto (Alt + h/j/k/l)
bindkey -s '\eh' "tmux-bookmark goto 1\n"
bindkey -s '\ej' "tmux-bookmark goto 2\n"
bindkey -s '\ek' "tmux-bookmark goto 3\n"
bindkey -s '\el' "tmux-bookmark goto 4\n"
