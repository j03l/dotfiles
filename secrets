#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
source "$DOTFILES/lib/platform.sh"
MAPPING="$DOTFILES/secrets.env"
dry_run=0
[[ "${1:-}" == "--dry" ]] && dry_run=1

if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
    echo "ERROR: BWS_ACCESS_TOKEN is not set."
    echo ""
    echo "Setup:"
    echo "  1. Open Bitwarden Secrets Manager → Machine accounts → generate an access token"
    if is_macos; then
        echo "  2. Store it in the macOS Keychain:"
        echo "       security add-generic-password -s bws-access-token -a \"\$USER\" -w 'your-token'"
        echo "  3. Open a new shell (loads token from .zsh_profile) or export manually:"
        echo "       export BWS_ACCESS_TOKEN=\$(security find-generic-password -s bws-access-token -w)"
    else
        echo "  2. Store it in the KDE keyring:"
        echo "       secret-tool store --label='Passwords/bws-access-token' server Passwords user bws-access-token"
        echo "  3. Open a new shell (loads token from .zsh_profile) or export manually:"
        echo "       export BWS_ACCESS_TOKEN=\$(secret-tool lookup server Passwords user bws-access-token)"
    fi
    echo "  4. Re-run this script"
    exit 1
fi

if ! command -v bws &>/dev/null; then
    echo "ERROR: bws is not installed."
    exit 1
fi

if ! command -v jq &>/dev/null; then
    echo "ERROR: jq is not installed."
    exit 1
fi

# Read environment from ~/.dotfiles-env, or prompt if missing
selected_env=""
if [[ -f "$HOME/.dotfiles-env" ]]; then
    selected_env=$(cat "$HOME/.dotfiles-env")
fi
if [[ -z "$selected_env" ]]; then
    echo "No environment set. Run ./install or select now:"
    select env in home work; do
        if [[ -n "$env" ]]; then
            selected_env="$env"
            echo "$selected_env" > "$HOME/.dotfiles-env"
            break
        fi
    done
fi
echo "Environment: $selected_env"

# Remove secrets mapped to a *different* environment (stale after a home/work
# switch). Files we are about to re-fetch are deliberately NOT pre-deleted:
# each is replaced atomically below, so an offline or failed run leaves the
# existing file intact rather than wiping it. This matters most for ~/.ssh keys.
while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    read -r _uuid target _perms env <<< "$line"
    target="${target/#\~/$HOME}"

    # entries with no env, or matching this env, are refreshed rather than cleaned
    [[ -z "${env:-}" || "$env" == "$selected_env" ]] && continue

    if [[ -f "$target" ]]; then
        if [[ "$dry_run" == "1" ]]; then
            echo "[DRY_RUN] rm $target (scoped to '$env', not '$selected_env')"
        else
            rm "$target"
            echo "clean: $target (scoped to '$env')"
        fi
    fi
done < "$MAPPING"

errors=0
tmp=""
cleanup() { [[ -n "${tmp:-}" && -f "${tmp:-}" ]] && rm -f "$tmp"; return 0; }
trap cleanup EXIT

while IFS= read -r line; do
    # skip comments and blank lines
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    read -r uuid target perms env <<< "$line"
    target="${target/#\~/$HOME}"

    # skip entries that don't match the selected environment
    if [[ -n "${env:-}" && "$env" != "$selected_env" ]]; then
        continue
    fi

    if [[ "$dry_run" == "1" ]]; then
        name=$(bws secret get "$uuid" -o json 2>/dev/null | jq -r '.key // empty') || name="<fetch failed>"
        echo "[DRY_RUN] $name -> $target (mode $perms)"
        continue
    fi

    json=$(bws secret get "$uuid" -o json 2>/dev/null) || true
    value=$(printf '%s' "$json" | jq -r '.value // empty')
    if [[ -z "$value" ]]; then
        echo "FAIL: could not fetch secret $uuid (left $target untouched)"
        errors=$((errors + 1))
        continue
    fi

    name=$(printf '%s' "$json" | jq -r '.key // empty')
    mkdir -p "$(dirname "$target")"
    # Write to a temp file alongside the target, set its mode, then rename.
    # mktemp creates at 0600 and mv within a filesystem is atomic, so the target
    # is never a partial file and never briefly world-readable.
    tmp=$(mktemp "$target.XXXXXX")
    printf '%s\n' "$value" > "$tmp"
    chmod "$perms" "$tmp"
    mv -f "$tmp" "$target"
    tmp=""
    echo "ok: $name -> $target"
done < "$MAPPING"

if [[ "$errors" -gt 0 ]]; then
    echo ""
    echo "$errors secret(s) failed. Check UUIDs and BWS_ACCESS_TOKEN."
    exit 1
fi

echo "secrets complete."
