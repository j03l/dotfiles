#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)}"
source "$DOTFILES/lib/platform.sh"

# bun is not in the official repos. Install via the upstream installer, which
# lands in ~/.bun — matching the BUN_INSTALL / PATH block in .zshrc. The
# installer needs unzip; macOS ships it, Arch needs the package.
if command -v bun &>/dev/null; then
    echo "bun already installed"
    exit 0
fi

is_linux && paru -S --needed --noconfirm unzip
echo "Installing bun via bun.sh installer..."
curl -fsSL https://bun.sh/install | bash
