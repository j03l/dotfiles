#!/usr/bin/env bash
set -euo pipefail

# fzf + jq are required by tmux-claude-session-manager
paru -S --needed --noconfirm tmux fzf jq

# TPM lives alongside the XDG config so it resolves TMUX_PLUGIN_MANAGER_PATH
# to ~/.config/tmux/plugins/ (gitignored in dotfiles).
TPM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"
if [[ -d "$TPM_DIR" ]]; then
    echo "TPM already installed"
else
    echo "Installing TPM..."
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

echo "tmux ready (press prefix + I inside tmux to install plugins)"
