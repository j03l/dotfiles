#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)}"
source "$DOTFILES/lib/platform.sh"

# fzf + jq are required by tmux-claude-session-manager
pkg_install tmux fzf jq

# TPM goes straight into the repo's (gitignored) plugins dir, which is what
# ~/.config/tmux/plugins/ resolves to once deploy symlinks ~/.config/tmux.
# Installing via ~/.config/tmux instead broke fresh installs: ./install runs
# this before deploy, so the clone landed in a real ~/.config/tmux dir that
# deploy then rm -rf'd to make room for the symlink.
PLUGIN_DIR="$DOTFILES/env/.config/tmux/plugins"
TPM_DIR="$PLUGIN_DIR/tpm"
if [[ -d "$TPM_DIR" ]]; then
    echo "TPM already installed"
else
    echo "Installing TPM..."
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

# Install every @plugin from tmux.conf now rather than waiting for prefix + I.
# TPM's CLI installer needs no running tmux server, but it reads tmux.conf from
# ~/.config/tmux — which only exists after deploy — so point it at the repo copy.
echo "Installing tmux plugins..."
TMUX_PLUGIN_MANAGER_PATH="$PLUGIN_DIR/" \
XDG_CONFIG_HOME="$DOTFILES/env/.config" \
    "$TPM_DIR/bin/install_plugins"

echo "tmux ready"
