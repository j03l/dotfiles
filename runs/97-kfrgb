#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)}"
source "$DOTFILES/lib/platform.sh"
# Linux-only: SMBus RAM lighting on a specific desktop board.
is_linux || { echo "97-kfrgb: skip (Linux-only)"; exit 0; }

# kfrgb refuses to run without yad + lshw, and drives the SMBus via i2c-tools.
pkg_install i2c-tools yad lshw

SRC="$DOTFILES/system/kfrgb-retry"
DEST="/usr/local/bin/kfrgb-retry"

# kfrgb itself is third-party (GPL-3.0, github.com/KeyofBlueS/kfrgb) and
# self-updates, so it is not vendored in this repo. Without it the wrapper
# has nothing to call.
if [[ ! -x /usr/local/bin/kfrgb ]]; then
    echo "97-kfrgb: skip — /usr/local/bin/kfrgb not found."
    echo "  Install it first:"
    echo "    git clone https://github.com/KeyofBlueS/kfrgb /tmp/kfrgb"
    echo "    sudo install -Dm755 /tmp/kfrgb/kfrgb.sh /opt/kfrgb/kfrgb.sh"
    echo "    sudo ln -sf /opt/kfrgb/kfrgb.sh /usr/local/bin/kfrgb"
    exit 0
fi

# Installed as a root-owned copy rather than a symlink into the repo: the
# ramon/ramoff aliases call this with sudo, and sudo running a user-writable
# file is a privilege-escalation path.
if [[ -f "$DEST" ]] && cmp -s "$SRC" "$DEST"; then
    echo "97-kfrgb: ok (already current) $DEST"
    exit 0
fi

echo "97-kfrgb: installing $DEST (root-owned, 755)"
sudo install -Dm755 -o root -g root "$SRC" "$DEST"
echo "97-kfrgb: done. Test with: ramon / ramoff"
