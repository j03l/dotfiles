#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." &>/dev/null && pwd)}"
source "$DOTFILES/lib/platform.sh"

# Cross-platform CLI tooling (same names on brew and paru)
pkg_install fzf ripgrep btop eza expect lazygit glow jq

if is_macos; then
    # bws (Bitwarden Secrets Manager CLI) has no brew formula — install via
    # Bitwarden's official installer script. Docker on macOS is Docker
    # Desktop, managed as a cask in macos.Brewfile; no daemon/group
    # provisioning is needed.
    command -v bws &>/dev/null || curl -fsSL https://bws.bitwarden.com/install | sh
else
    paru -S --needed --noconfirm bws-bin docker docker-compose

    # Enable docker (idempotent)
    sudo systemctl enable docker.service
    sudo systemctl enable docker.socket
    sudo systemctl enable containerd.service

    # Add current user to docker group if not already a member
    if ! groups "$USER" | grep -q '\bdocker\b'; then
        sudo usermod -aG docker "$USER"
        echo "Added $USER to docker group (logout/login required to take effect)"
    fi
fi

echo "dev tools installed"
