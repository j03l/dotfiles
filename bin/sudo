#!/usr/bin/env bash
# sudo wrapper: when stdin is not a TTY (e.g. running inside Claude Code or
# any non-interactive context), automatically pass -A and export SUDO_ASKPASS
# so a desktop dialog handles the prompt: ksshaskpass on KDE, zenity-askpass
# on GNOME. With a real TTY, behave exactly like /usr/bin/sudo.
REAL_SUDO=/usr/bin/sudo

if [[ ! -t 0 ]]; then
  if [[ -z "${SUDO_ASKPASS:-}" ]]; then
    if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* && -x /usr/bin/ksshaskpass ]]; then
      SUDO_ASKPASS=/usr/bin/ksshaskpass
    else
      SUDO_ASKPASS="$HOME/.local/bin/zenity-askpass"
    fi
  fi
  export SUDO_ASKPASS
  exec "$REAL_SUDO" -A "$@"
fi

exec "$REAL_SUDO" "$@"
