#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
export DOTFILES
source "$DOTFILES/lib/platform.sh"

dry_run="0"
[[ "${1:-}" == "--dry" ]] && dry_run="1"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Read or prompt for environment
selected_env=""
[[ -f "$HOME/.dotfiles-env" ]] && selected_env=$(cat "$HOME/.dotfiles-env")
if [[ -n "$selected_env" ]]; then
    echo "Current environment: $selected_env"
    read -rp "Keep current? [Y/n] " answer
    if [[ ! "${answer:-y}" =~ ^[Yy]$ ]]; then
        selected_env=""
    fi
fi
if [[ -z "$selected_env" ]]; then
    echo "Select environment:"
    select env in home work; do
        if [[ -n "$env" ]]; then
            selected_env="$env"
            break
        fi
    done
fi
echo "$selected_env" > "$HOME/.dotfiles-env"
echo "Environment: $selected_env"
echo ""

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

# Warn if target is a real file/dir (not a symlink) — may contain local changes
check_overwrite() {
    local dest="$1"
    if [[ -e "$dest" && ! -L "$dest" ]]; then
        echo "WARNING: $dest is a real file/directory, not a symlink."
        read -rp "Overwrite? [y/N] " answer
        if [[ ! "$answer" =~ ^[Yy]$ ]]; then
            echo "skip: $dest"
            return 1
        fi
    fi
    return 0
}

# Remove target (file, dir, or stale symlink) then symlink
link_dir() {
    local src="$1" dest="$2"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
        log "ok (already linked) $dest -> $src"
        return
    fi
    if [[ $dry_run == "0" ]]; then
        check_overwrite "$dest" || return 0
    fi
    log "rm -rf $dest"
    log "ln -s  $src -> $dest"
    if [[ $dry_run == "0" ]]; then
        rm -rf "$dest"
        mkdir -p "$(dirname "$dest")"
        ln -s "$src" "$dest"
    fi
}

link_file() {
    local src="$1" dest="$2"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
        log "ok (already linked) $dest -> $src"
        return
    fi
    if [[ $dry_run == "0" ]]; then
        check_overwrite "$dest" || return 0
    fi
    log "rm -f $dest"
    log "ln -s $src -> $dest"
    if [[ $dry_run == "0" ]]; then
        mkdir -p "$(dirname "$dest")"
        rm -f "$dest"
        ln -s "$src" "$dest"
    fi
}

echo "=== deploy: nvim ==="
link_dir "$DOTFILES/nvim" "$XDG_CONFIG_HOME/nvim"

echo "=== deploy: env/.config/* ==="
for dir in "$DOTFILES"/env/.config/*/; do
    name=$(basename "$dir")
    [[ "$name" == "systemd" ]] && continue
    link_dir "${dir%/}" "$XDG_CONFIG_HOME/$name"
done

echo "=== deploy: kitty per-machine config ==="
kitty_choice="kitty.$selected_env.conf"
if [[ -f "$DOTFILES/env/.config/kitty/$kitty_choice" ]]; then
    # Relative target so the symlink resolves inside ~/.config/kitty
    log "ln -sfn $kitty_choice -> $XDG_CONFIG_HOME/kitty/local.conf"
    if [[ $dry_run == "0" ]]; then
        ln -sfn "$kitty_choice" "$XDG_CONFIG_HOME/kitty/local.conf"
    fi
else
    log "skip: no $kitty_choice (kitty per-machine config)"
fi

echo "=== deploy: zed per-machine settings ==="
# Zed's settings.json has no #include mechanism, so the per-machine file is built
# here instead of symlinked: settings.base.json * settings.<machine_id>.json.
#
# Note the output path resolves *back into this repo* — the env/.config/* loop above
# already symlinked ~/.config/zed -> $DOTFILES/env/.config/zed, so the generated file
# lands next to its own sources. That is why env/.config/zed/settings.json is
# gitignored; it is a build artifact, not tracked config. Don't edit it directly.
zed_base="$DOTFILES/env/.config/zed/settings.base.json"
zed_override="$DOTFILES/env/.config/zed/settings.$(machine_id).json"
zed_target="$XDG_CONFIG_HOME/zed/settings.json"
if ! command -v jq &>/dev/null; then
    log "skip: jq not installed (zed settings not merged)"
elif [[ -f "$zed_override" ]]; then
    log "jq merge $(basename "$zed_base") + $(basename "$zed_override") -> $zed_target"
    if [[ $dry_run == "0" ]]; then
        mkdir -p "$(dirname "$zed_target")"
        jq -s '.[0] * .[1]' "$zed_base" "$zed_override" > "$zed_target"
    fi
else
    log "cp $(basename "$zed_base") -> $zed_target (no override for $(machine_id))"
    if [[ $dry_run == "0" ]]; then
        mkdir -p "$(dirname "$zed_target")"
        cp "$zed_base" "$zed_target"
    fi
fi

if is_linux; then
    echo "=== deploy: systemd user units ==="
    mkdir -p "$XDG_CONFIG_HOME/systemd/user"
    for unit in "$DOTFILES"/env/.config/systemd/user/*.service; do
        [[ -f "$unit" ]] || continue
        name=$(basename "$unit")
        link_file "$unit" "$XDG_CONFIG_HOME/systemd/user/$name"
    done
else
    echo "=== deploy: systemd user units (skip: not Linux) ==="
fi

echo "=== deploy: gitconfig ==="
link_file "$DOTFILES/env/.gitconfig" "$HOME/.gitconfig"

if is_macos; then
    echo "=== deploy: mackup config ==="
    link_file "$DOTFILES/env/.mackup.cfg" "$HOME/.mackup.cfg"
fi

echo "=== deploy: zsh dotfiles ==="
link_file "$DOTFILES/env/.zshrc" "$HOME/.zshrc"
link_file "$DOTFILES/env/.zsh_profile" "$HOME/.zsh_profile"

# No ~/.tmux.conf link: tmux >=3.1 reads $XDG_CONFIG_HOME/tmux/tmux.conf directly,
# and env/.config/tmux is already symlinked as a whole. Linking both paths made tmux
# source the same config twice.

echo "=== deploy: zsh os fragment ($PLATFORM) ==="
mkdir -p "$XDG_CONFIG_HOME/zsh"
link_file "$DOTFILES/env/zsh/$PLATFORM.zsh" "$XDG_CONFIG_HOME/zsh/os.zsh"

echo "=== deploy: ssh config ==="
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
link_file "$DOTFILES/env/.ssh/config" "$HOME/.ssh/config"

echo "=== deploy: bin/ ==="
mkdir -p "$HOME/.local/bin"
# Linux/desktop-specific helpers — skip on macOS (KDE askpass, evdev, rclone mounts)
linux_only_bins=" sudo hscroll-volume kenesis icloud-2fa-watch.sh icloud-refresh-2fa.sh onedrive-precache.sh "
for script in "$DOTFILES"/bin/*; do
    [[ -f "$script" ]] || continue
    name=$(basename "$script")
    [[ "$name" == "README.md" ]] && continue
    if is_macos && [[ "$linux_only_bins" == *" $name "* ]]; then
        log "skip (Linux-only): $name"
        continue
    fi
    link_file "$script" "$HOME/.local/bin/$name"
done

log "deploy complete."
